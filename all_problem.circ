  <vhdl appearance="logisim_evolution" name="prob1">library ieee;
use ieee.std_logic_1164.all;

entity prob1 is
    port (
        a, b, c, d : in std_logic;
        out1       : out std_logic;
        out2       : out std_logic
    );
end entity prob1;

architecture bhv of prob1 is
begin
    out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end architecture bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="prob2">library ieee;
use ieee.std_logic_1164.all;

entity prob2 is
    port (
        a, b, c, d, e, f, g, h : in std_logic;                   -- 입력 핀 8개
        sel                    : in std_logic_vector(2 downto 0); -- 선택 핀 3비트
        y                      : out std_logic                    -- 출력 핀 1개
    );
end entity prob2;

architecture bhv of prob2 is
begin
    process(a, b, c, d, e, f, g, h, sel)
    begin
        case sel is
            when "000" =&gt; y &lt;= a;
            when "001" =&gt; y &lt;= b;
            when "010" =&gt; y &lt;= c;
            when "011" =&gt; y &lt;= d;
            when "100" =&gt; y &lt;= e;
            when "101" =&gt; y &lt;= f;
            when "110" =&gt; y &lt;= g;
            when "111" =&gt; y &lt;= h;
            when others =&gt; y &lt;= '0';
        end case;
    end process;
end architecture bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="prob3">library ieee;
use ieee.std_logic_1164.all;

entity prob3 is
    port (
        sel     : in std_logic_vector(2 downto 0);
        display : out std_logic_vector(6 downto 0) -- g f e d c b a 순서
    );
end entity prob3;

architecture bhv of prob3 is
begin
    process(sel)
    begin
        case sel is
            -- display: "g fedcba" (1: ON, 0: OFF)
            when "000" =&gt; display &lt;= "1011111"; -- a
            when "001" =&gt; display &lt;= "1111100"; -- b
            when "010" =&gt; display &lt;= "0111001"; -- c
            when "011" =&gt; display &lt;= "1011110"; -- d
            when "100" =&gt; display &lt;= "1110001"; -- f
            when "101" =&gt; display &lt;= "1101111"; -- g
            when others =&gt; display &lt;= "0000000"; -- OFF
        end case;
    end process;
end architecture bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="prob4">	library ieee;
	use ieee.std_logic_1164.all;
	
	entity prob4 is
	    port (
	        vt     : in std_logic_vector(25 downto 1);
	        result : out std_logic
	    );
	end entity prob4;
	
	architecture bhv of prob4 is
	begin
	    process(vt)
	        variable sum : integer range 0 to 25;
	    begin
	        sum := 0;
	        for i in 1 to 25 loop
	            if vt(i) = '1' then
	                sum := sum + 1;
	            end if;
	        end loop;
	
	        if sum &gt;= 13 then
	            result &lt;= '1';
	        else
	            result &lt;= '0';
	        end if;
	    end process;
	end architecture bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="prob5">library ieee;
use ieee.std_logic_1164.all;

entity prob5 is
    port (
        en      : in std_logic;
        vt      : in std_logic_vector(13 downto 1);
        display : out std_logic_vector(6 downto 0) -- g f e d c b a
    );
end entity prob5;

architecture bhv of prob5 is
begin
    process(en, vt)
        variable sum : integer range 0 to 13;
    begin
        if en = '0' then
            display &lt;= "0000000"; -- 소등 (OFF)
        else
            sum := 0;
            for i in 1 to 13 loop
                if vt(i) = '1' then
                    sum := sum + 1;
                end if;
            end loop;

            case sum is
                when 0 =&gt; display &lt;= "0111111"; -- 0
                when 1 =&gt; display &lt;= "0000110"; -- 1
                when 2 =&gt; display &lt;= "1011011"; -- 2
                when 3 =&gt; display &lt;= "1001111"; -- 3
                when 4 =&gt; display &lt;= "1100110"; -- 4
                when 5 =&gt; display &lt;= "1101101"; -- 5
                when 6 =&gt; display &lt;= "1111101"; -- 6
                when 7 =&gt; display &lt;= "0000111"; -- 7
                when 8 =&gt; display &lt;= "1111111"; -- 8
                when 9 =&gt; display &lt;= "1101111"; -- 9
                when 10 =&gt; display &lt;= "1110111"; -- A
                when 11 =&gt; display &lt;= "1111100"; -- b
                when 12 =&gt; display &lt;= "0111001"; -- C
                when 13 =&gt; display &lt;= "1011110"; -- d
                when others =&gt; display &lt;= "0000000";
            end case;
        end if;
    end process;
end architecture bhv;</vhdl>
